# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 110

[*.md]
# Markdown uses two trailing spaces for hard line breaks.
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab
